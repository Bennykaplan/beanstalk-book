# Copy to .env for local runs. Never commit .env.
OPENAI_API_KEY=
# Stripe test-mode secret key (sk_test_...). Never commit it: Stripe revokes keys found on GitHub.
STRIPE_SECRET_KEY=
# Lulu Print API sandbox (developers.sandbox.lulu.com > API keys)
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Shown on the copyright page as the publisher
PUBLISHER=
# OpenAI image calls allowed per minute on your account (20 at the lowest paid level)
IMAGES_PER_MINUTE=20
# Optional overrides
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=low
# Google sign-in (console.cloud.google.com > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs login cookies. Any long random string.
SESSION_SECRET=
# Postgres. Leave empty locally to use PGlite in .localdb/. Required on Render.
DATABASE_URL=
# Spending limits (images per day)
IMAGES_PER_USER_PER_DAY=25
IMAGES_PER_DAY=150
# Parallel image calls across all users
MAX_PARALLEL_IMAGES=4
# Local testing only: free fake images, and a login button that skips Google
# IMAGE_PROVIDER=mock
# DEV_LOGIN=1
